{
  "manifest_version": 3,
  "name": "视频下载器（HLS / B站 / 抖音 / 腾讯视频 / 优酷）",
  "version": "1.4.0",
  "description": "在浏览器内下载网页 HLS(m3u8) 视频、B 站、抖音、腾讯视频与优酷（免费内容）：自动检测、并发下载、AES-128 解密、封装或合并为 MP4。",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bilibili_referer",
        "enabled": true,
        "path": "rules/bilibili-referer.json"
      },
      {
        "id": "douyin_referer",
        "enabled": true,
        "path": "rules/douyin-referer.json"
      },
      {
        "id": "youku_referer",
        "enabled": true,
        "path": "rules/youku-referer.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*", "*://*.iesdouyin.com/*"],
      "js": ["src/page/douyin-capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "视频下载器（HLS / B站 / 抖音）",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
